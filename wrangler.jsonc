{
  // Sitio estático en Cloudflare (Workers Static Assets). Deploy manual: npm run build:web && npx wrangler deploy
  // "build.command" sirve para "wrangler deploy --dry-run" en local, pero Workers Builds (el deploy automático al
  // hacer git push) IGNORA este campo a propósito (documentado por Cloudflare): ahí el "Deploy command" del panel
  // tiene que ser "npm run deploy:web" en vez de "npx wrangler deploy" (ver docs/13-instalacion.md).
  "name": "vidasim",
  "compatibility_date": "2026-09-21",
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
