    "lint": "eslint .",
    "format": "prettier --write src/engine src/store src/ui App.tsx",
    "format:check": "prettier --check src/engine src/store src/ui App.tsx",
    "icons": "node scripts/gen-icons.mjs",
    "check:all": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "balance": "tsx scripts/balance.ts",
    "build:web": "expo export --platform web"
